DATAGEMS_POSTGRES_HOST=host_name
DATAGEMS_POSTGRES_PORT=5555
DATAGEMS_POSTGRES_USERNAME=username
DATAGEMS_POSTGRES_PASSWORD=password

DATAGEMS_TIMESCALE_DB_HOST=host_name
DATAGEMS_TIMESCALE_DB_PORT=5555
DATAGEMS_TIMESCALE_DB_USERNAME=username
DATAGEMS_TIMESCALE_DB_PASSWORD=password

# Root path prepended to distribution file paths (mount to S3)
DATA_ROOT_PATH=''
# Prefix prepended to RawDataPath connector dataset IDs on the Ray worker
MOUNT_POINT=''
# Directory where generated CDD profile JSON files are written
CDD_PROFILE_PATH=''

RAY_ADDRESS=ray://localhost:10001

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

ENABLE_AUTH=false

# LLM-based data quality error detection for tabular record sets (opt-in)
ENABLE_DATA_QUALITY=false
# LLM provider used for detection: "scayle" or "bedrock"
DATA_QUALITY_LLM_PROVIDER=scayle
# Optional model override (defaults: qwen3.6 for scayle, us.anthropic.claude-sonnet-4-6 for bedrock)
# DATA_QUALITY_LLM_MODEL=
# Attempts per LLM call (initial try + retries) on transient network failures
DATA_QUALITY_LLM_MAX_ATTEMPTS=3
# After retries are exhausted, skip detection for this many seconds instead of
# re-probing a dead endpoint for every remaining table (0 disables)
DATA_QUALITY_LLM_COOLDOWN=300

# Column statistics of database tables (opt-in). They read every row: seconds for
# small tables, minutes per table above ~100M rows.
ENABLE_DB_STATISTICS=false

# Semantic type annotation (CTA) always runs for tabular record sets and uses SCAYLE.
# Optional model override (default: qwen3). SCAYLE model ids are case sensitive.
# CTA_LLM_MODEL=

# Keywords and a summary for each PDF and text document and each JSON file, one
# SCAYLE call per file (on by default; set to false to skip).
ENABLE_DOCUMENT_LLM=true
# Optional model override (default: qwen3.8-flash-next) and timeout in seconds (default: 120)
# DOCUMENT_LLM_MODEL=
# DOCUMENT_LLM_TIMEOUT=
# LLM time all documents of one profiling job may use, in seconds (default: 600; 0 for no limit).
# Documents past it get no keywords or summary.
# DOCUMENT_LLM_TIME_BUDGET_SECONDS=
# Tesseract OCR of PDF pages without a text layer (default: on, English)
# DOCUMENT_OCR_ENABLED=true
# DOCUMENT_OCR_LANGUAGE=eng

# MathE document endpoints (/documents). Tokens are verified against Keycloak,
# and forwarded to MoMa to look up the FileObjects.
DOCUMENTS_AUTH_ENABLED=true
OIDC_ISSUER_URL=https://datagems-dev.scayle.es/oauth/realms/dev
OIDC_AUDIENCE=dataset-profiler-api
# DOCUMENTS_ALLOWED_ROLES=user,dg_user,dg_system
MOMA_API_URL=https://datagems-dev.scayle.es/moma2/v1
# Where the bucket is mounted, for s3:// contentUrls (default: /s3); files must lie under DATA_ROOT_PATH
# DOCUMENT_S3_MOUNT=/s3
# Files per request (default: 20), seconds a request waits (default: 240), cache lifetime (default: 30 days)
# DOCUMENT_MAX_FILES=
# DOCUMENT_REQUEST_TIMEOUT_SECONDS=
# DOCUMENT_CACHE_TTL_SECONDS=
# Vision model for "quality" mode (default: glm-5.3-flash)
# DOCUMENT_VLM_MODEL=

# JSON and JSON Lines files. Their record sets go into the heavy (MoMa) profile
# unless set to false; the CDD profile always carries them.
ENABLE_JSON_RECORD_SETS=true
# JSON files per folder that get semantic types and a summary (default: 20).
# JSON_LLM_MAX_FILES_PER_FOLDER=

# Required when DATA_QUALITY_LLM_PROVIDER=scayle
SCAYLE_BASE_URL=https://scayle-host/api
SCAYLE_USERNAME=username
SCAYLE_PASSWORD=password
SCAYLE_VERIFY_SSL=false

# Required when DATA_QUALITY_LLM_PROVIDER=bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
